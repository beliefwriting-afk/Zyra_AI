# 複製成 backend/.env 後填入實際值。
# .env 已被 .gitignore 排除，絕對不要提交。

# session cookie 簽章金鑰。產生方式：
#   python -c "import secrets; print(secrets.token_hex(32))"
ZYRA_SECRET_KEY=

# Google Cloud Console → API 和服務 → 憑證 → OAuth 2.0 用戶端 ID（網頁應用程式）
ZYRA_GOOGLE_CLIENT_ID=

# 允許登入的 email，逗號分隔。留空代表全部拒絕。
ZYRA_ALLOWLIST=you@example.com

# development | production
ZYRA_ENV=development

# 資料庫檔案位置。正式環境請指到持久磁碟上的路徑。
# ZYRA_DB_PATH=/var/lib/zyra/zyra.db

# session 有效天數
# ZYRA_SESSION_DAYS=30

# Gemini API key（AI 助理用）。留空則助理功能停用，其餘功能不受影響。
# 取得方式：https://aistudio.google.com/apikey
ZYRA_GEMINI_API_KEY=

# 預設 gemini-2.5-flash。要換模型改這裡就好。
# ZYRA_GEMINI_MODEL=gemini-2.5-flash
